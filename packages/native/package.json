{
  "name": "@e2e-platform/native",
  "version": "0.2.0-rc.7",
  "description": "Native desktop engine for e2e over an authenticated local bridge",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "rc"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "PROTOCOL.md",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@e2e-platform/process": "workspace:*"
  },
  "peerDependencies": {
    "@e2e-platform/core": ">=0.2.0-rc.7 <1.0.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "@types/node": "26.6.2",
    "@e2e-platform/core": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedAredah/e2e-platform.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/AhmedAredah/e2e-platform/issues"
  },
  "homepage": "https://github.com/AhmedAredah/e2e-platform/tree/main/packages/native#readme"
}
