{
  "name": "@e2e-platform/protocol",
  "version": "0.2.0-rc.6",
  "description": "Bounded HTTP protocol fixtures for e2e tests",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "rc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedAredah/e2e-platform.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/AhmedAredah/e2e-platform/issues"
  },
  "homepage": "https://github.com/AhmedAredah/e2e-platform/tree/main/packages/protocol#readme"
}
