{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "changelog": [
    "@changesets/cli/changelog",
    null
  ],
  "commit": false,
  "access": "public",
  "baseBranch": "mit-cpp",
  "updateInternalDependencies": "patch",
  "fixed": [],
  "linked": [],
