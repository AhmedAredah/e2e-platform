{
  "name": "@e2e-platform/web-benchmark",
  "version": "0.0.0",
  "private": true,
  "description": "Benchmark app of hard web surfaces, with the e2e suites written against them",
  "type": "module",
  "scripts": {
    "dev": "next dev app --port 4280",
    "build": "next build app",
    "start": "next start app --port 4280",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node node_modules/@e2e-platform/core/dist/cli/bin.js run",
    "test:headed": "pnpm run build && node node_modules/@e2e-platform/core/dist/cli/bin.js run --headed",
    "test:agent": "pnpm run build && node node_modules/@e2e-platform/core/dist/cli/bin.js run --config e2e.agent.config.ts"
  },
  "dependencies": {
    "@e2e-platform/core": "workspace:*",
    "@e2e-platform/playwright": "workspace:*",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@e2e-platform/github": "workspace:*",
    "@types/node": "26.4.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.97",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
