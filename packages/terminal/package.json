{
  "name": "@e2e-platform/terminal",
  "version": "0.2.0-rc.3",
  "description": "PTY-backed terminal engine with real VT screen reconstruction for e2e",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/session.test.ts tests/keys.test.ts tests/engine.test.ts"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "@xterm/addon-unicode11": "0.9.0"
  },
  "peerDependencies": {
    "@e2e-platform/core": ">=0.2.0-rc.0 <1.0.0",
    "@e2e-platform/process": ">=0.2.0-rc.0 <1.0.0",
    "node-pty": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "node-pty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@e2e-platform/core": "workspace:*",
    "@e2e-platform/process": "workspace:*",
    "node-pty": "1.1.0",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "rc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedAredah/e2e-platform.git",
    "directory": "packages/terminal"
  },
  "bugs": {
    "url": "https://github.com/AhmedAredah/e2e-platform/issues"
  },
  "homepage": "https://github.com/AhmedAredah/e2e-platform/tree/mit-main/packages/terminal#readme"
}
