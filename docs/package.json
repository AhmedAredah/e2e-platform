{
  "name": "@e2e-cpp/docs",
  "private": true,
  "description": "The e2e documentation site, built with Mintlify",
  "type": "module",
  "scripts": {
    "dev": "mint dev",
    "check": "node ../scripts/check-docs-examples.ts && node ../scripts/check-docs-local.mjs",
    "typecheck": "tsc --noEmit --project examples/tsconfig.json",
    "check:online": "mint validate && mint broken-links"
  },
  "devDependencies": {
    "@e2e-cpp/agent-device": "workspace:*",
    "@e2e-cpp/core": "workspace:*",
    "@e2e-cpp/playwright": "workspace:*",
    "@types/node": "26.4.1",
    "agent-device": "0.21.6",
    "ai": "7.0.97",
    "mint": "4.2.883",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
