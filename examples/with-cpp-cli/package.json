{
  "name": "e2e-example-with-cpp-cli",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native": "cmake -S . -B build -DBUILD_TESTING=ON && cmake --build build --config Release",
    "test:ctest": "ctest --test-dir build -C Release --output-on-failure",
    "test:e2e": "e2e-platform run --no-model",
    "test:e2e:negative": "e2e-platform run --config e2e.negative.config.ts --no-model",
    "verify": "node ../../scripts/native/verify.mjs",
    "test:http": "e2e-platform run --config e2e.http.config.ts --no-model",
    "test:http:negative": "e2e-platform run --config e2e.http.negative.config.ts --no-model",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@e2e-platform/checks": "workspace:*",
    "@e2e-platform/process": "workspace:*",
    "@e2e-platform/core": "workspace:*",
    "@e2e-platform/protocol": "workspace:*",
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
