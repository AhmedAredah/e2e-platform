{
  "name": "@e2e-platform/authoring",
  "version": "0.2.0-rc.8",
  "description": "Bounded language-neutral test host for the shared e2e-platform runner",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "rc"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@e2e-platform/core": ">=0.2.0-rc.7 <1.0.0",
    "@e2e-platform/process": ">=0.2.0-rc.7 <1.0.0",
    "@e2e-platform/protocol": ">=0.2.0-rc.7 <1.0.0",
    "@e2e-platform/native": ">=0.2.0-rc.7 <1.0.0",
    "@e2e-platform/terminal": ">=0.2.0-rc.7 <1.0.0"
  },
  "devDependencies": {
    "@e2e-platform/core": "workspace:*",
    "@e2e-platform/process": "workspace:*",
    "@e2e-platform/protocol": "workspace:*",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@e2e-platform/native": "workspace:*",
    "@e2e-platform/terminal": "workspace:*"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AhmedAredah/e2e-platform.git",
    "directory": "packages/authoring"
  },
  "bugs": {
    "url": "https://github.com/AhmedAredah/e2e-platform/issues"
  },
  "homepage": "https://github.com/AhmedAredah/e2e-platform/tree/main/packages/authoring#readme",
  "peerDependenciesMeta": {
    "@e2e-platform/native": {
      "optional": true
    },
    "@e2e-platform/terminal": {
      "optional": true
    }
  }
}
