{
  "name": "@e2e-platform/core",
  "version": "0.2.0-rc.1",
  "description": "SDK, runner, and CLI for agentic end-to-end testing",
  "keywords": [
    "@e2e-platform/core",
    "testing",
    "agentic",
    "end-to-end"
  ],
  "license": "MIT",
  "contributors": [
    "Oskar Kwa\u015bniewski <oskar@tester.army>",
    "Szymon Rybczak <szymon@tester.army>"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": false,
    "tag": "rc"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/public.d.ts",
      "default": "./dist/agent/public.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    }
  },
  "bin": {
    "e2e-platform": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');for(const dir of ['dist','skills'])fs.rmSync(dir,{recursive:true,force:true});fs.cpSync('../../skills/e2e','skills/e2e',{recursive:true})\" && tsc --project tsconfig.build.json && node -e \"const fs=require('node:fs');const read=(dir)=>JSON.parse(fs.readFileSync('../'+dir+'/package.json','utf8'));const versions=Object.fromEntries(['playwright','agent-device','oauth','process','native'].map((dir)=>['@e2e-platform/'+dir,read(dir).version]));versions.playwright=read('playwright').devDependencies.playwright;fs.writeFileSync('dist/cli/init/sibling-versions.json',JSON.stringify(versions)+'\\n')\" && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@clack/prompts": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "@types/json-schema": "7.0.15",
    "@vitest/expect": "5.0.0",
    "commander": "15.0.0",
    "picocolors": "1.1.1",
    "pngjs": "7.0.0",
    "tsx": "4.23.13",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.47",
    "@e2e-platform/playwright": "workspace:*",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@types/node": "26.4.1",
    "@types/pngjs": "6.0.5",
    "ai": "7.0.97",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
