@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(NOT CMAKE_SIZEOF_VOID_P EQUAL @CMAKE_SIZEOF_VOID_P@ OR
   NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@")
  set(e2eQtBridge_FOUND FALSE)
  set(e2eQtBridge_NOT_FOUND_MESSAGE "Use the compiler family and word size of the installed Qt bridge kit, or rebuild it for this kit")
  return()
endif()
find_dependency(Qt6 @Qt6_VERSION@ EXACT COMPONENTS Widgets Network Test)
if(@E2E_QT_CONFIG_QUICK@)
  find_dependency(Qt6 @Qt6_VERSION@ EXACT COMPONENTS Quick Qml)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/e2eQtBridgeTargets.cmake")
